generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Campaign {
  id             String    @id @default(cuid())
  name           String
  query          String
  location       String
  offerText      String
  country        String?
  selectedCities String[]  @default([])
  businessType   String?
  websiteOffer   String?
  crmOffer       String?
  status         String    @default("active") // active | paused | completed
  autoSend       Boolean   @default(false)
  leads          Lead[]
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?
}

model Lead {
  id            String    @id @default(cuid())
  campaignId    String
  companyName   String
  website       String?
  email         String?
  emailSource   String?   // scraped | web_search | guessed | enriched | imported | manual
  emailStatus   String?   // verified | catch_all | unverified | invalid
  emailVerifiedAt DateTime?
  enrichmentTriedAt DateTime? // last paid enrichment (Hunter) attempt — skip on re-run to avoid re-billing
  hasContactForm Boolean?  // contact form detected on their website
  facebookUrl   String?   // Facebook page found during scraping
  description   String?
  category      String?   // website_proposal | crm
  address       String?
  phone         String?
  rating        Float?
  mapsUrl       String?
  placeId       String?
  score         Int       @default(0)
  state          String    @default("discovered")
  lastTouchedAt  DateTime?
  messages       Message[]
  jobs           Job[]
  calendarEvents CalendarEvent[]
  campaign      Campaign  @relation(fields: [campaignId], references: [id])
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  @@unique([campaignId, placeId])
}

model Message {
  id             String   @id @default(cuid())
  leadId         String
  direction      String   // outbound | inbound | system
  subject        String?
  body           String   // canonical plain text: thread previews, AI follow-up context, search
  bodyHtml       String?  // rich-text rendering (replies/follow-ups); null for plain/AI-generated
  resendId       String?  // Resend email ID for webhook correlation
  deliveryStatus String?  // sent | delivered | opened | bounced | complained
  sentAt         DateTime @default(now())
  lead           Lead     @relation(fields: [leadId], references: [id])
}

model Job {
  id          String   @id @default(cuid())
  leadId      String
  type        String   // followup_2 | followup_3 | followup_4
  scheduledAt DateTime
  status      String   @default("pending") // pending | done | cancelled | failed
  bullmqId    String? // reserved for future BullMQ integration
  lead        Lead     @relation(fields: [leadId], references: [id])
}

model Settings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  offerText            String?
  fromEmail            String?
  fromName             String?
  signatureHtml        String?  // reusable email signature (rich text); appended at send-time
  signatureText        String?  // plain-text fallback for the text/* part + WhatsApp
  resendApiKey         String?
  firecrawlApiKey      String?
  anthropicApiKey      String?
  emailVerifierApiKey  String?
  enrichmentProvider   String?  @default("hunter") // hunter | anymailfinder | apify
  enrichmentApiKey     String?
  apifyApiKey          String?  // Apify token — fallback email finder when Hunter quota is spent
  googleMapsApiKey     String?
  telegramChatId       String?
  googleClientId       String?
  googleClientSecret   String?
  googleRefreshToken   String?
  calendarId           String?  @default("primary")
  dailySendLimit          Int     @default(100)
  perCampaignDailyLimit   Int     @default(50)
  sendThrottleSeconds     Int     @default(30)
  autoSendReplies         Boolean @default(false)
  notifyHotOnly           Boolean @default(false)
  notifyEmailDigest       Boolean @default(false)
}

model CalendarEvent {
  id          String   @id @default(cuid())
  leadId      String
  googleEventId String?
  meetLink    String?
  startTime   DateTime
  endTime     DateTime
  title       String
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id])
}

model Suppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String   // bounced | unsubscribed | manual | complained
  createdAt DateTime @default(now())
}

model PendingConfirmation {
  id          String   @id @default(cuid())
  leadId      String
  type        String   // "booking" | "reply"
  context     String   // JSON: { slots, slotIndex, inboundBody, companyName, ... }
  status      String   @default("pending") // pending | confirmed | skipped
  createdAt   DateTime @default(now())
}
