generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique // stable identity — NextAuth token.sub is NOT stable here
  googleSub          String?      @unique // account.providerAccountId, backfilled on login
  name               String?
  image              String?
  googleRefreshToken String?      // powers calendar booking; encrypted at rest
  defaultOrgId       String?      // which membership's org the JWT binds to (invite acceptance sets this)
  memberships        Membership[]
  createdAt          DateTime     @default(now())
}

model Organization {
  id                 String       @id @default(cuid())
  name               String
  subscriptionTier   String       @default("pro")
  billingCustomerId  String?
  billingStatus      String       @default("active")
  memberships        Membership[]
  invites            Invite[]
  createdAt          DateTime     @default(now())
}

model Membership {
  id        String       @id @default(cuid())
  userId    String
  orgId     String
  role      String       @default("member") // owner | admin | member
  user      User         @relation(fields: [userId], references: [id])
  org       Organization @relation(fields: [orgId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([userId, orgId])
}

model Invite {
  id          String       @id @default(cuid())
  orgId       String
  email       String
  role        String       @default("member")
  token       String       @unique @default(cuid())
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  org         Organization @relation(fields: [orgId], references: [id])
  createdAt   DateTime     @default(now())

  @@index([email])
}

model Campaign {
  id             String    @id @default(cuid())
  orgId          String
  name           String
  query          String
  location       String
  offerText      String
  country        String?
  selectedCities String[]  @default([])
  selectedAreas  Json?     // { [city: string]: string[] } — user-selected hotspot areas per city
  businessType   String?   // denormalized display/fallback; businessTypeId is the source of truth for grouping
  businessTypeId String?
  businessTypeRef BusinessType? @relation(fields: [businessTypeId], references: [id])
  websiteOffer   String?
  crmOffer       String?
  status         String    @default("active") // active | paused | completed
  autoSend       Boolean   @default(false)
  autoPauseEnabled Boolean @default(true)
  scoutDepth     String    @default("normal") // light | normal | deep — maps to Places budgets
  followupOffsets  Int[]    @default([3])    // days after opener for each follow-up (max 3 steps)
  sendDays         Int[]    @default([1,2,3,4,5]) // ISO weekday: 1=Mon 7=Sun; which days emails can send
  sendWindowStart  String   @default("09:00")   // HH:MM UTC — earliest send time
  sendWindowEnd    String   @default("17:00")   // HH:MM UTC — latest send time (exclusive)
  timezone         String   @default("America/New_York") // Target IANA timezone
  opportunitiesValue Float   @default(0)
  conversionsValue   Float   @default(0)
  sequenceSteps      Json?   // Structured sequence steps & variants
  leads          Lead[]
  offers         CampaignOffer[]
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  @@index([orgId])
  @@index([businessTypeId])
}

model BusinessType {
  id           String     @id @default(cuid())
  orgId        String
  name         String
  defaultOffer String?    // inherited by campaigns whose own offerText is blank
  campaigns    Campaign[]
  createdAt    DateTime   @default(now())

  @@unique([orgId, name])
  @@index([orgId])
}

model CampaignOffer {
  id          String   @id @default(cuid())
  campaignId  String
  key         String   // stable slug stored in Lead.category (e.g. "website_proposal")
  label       String   // display name (e.g. "Website build")
  matchSignal String   @default("always") // has_website | no_website | always
  offerText   String
  angle       String? // background framing fed to the AI (soft mention only)
  order       Int      @default(0)
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([campaignId, key])
  @@index([campaignId])
}

model Lead {
  id            String    @id @default(cuid())
  orgId         String // denormalized from campaign for direct scoping
  campaignId    String
  companyName   String
  website       String?
  email         String?
  emailSource   String?   // scraped | web_search | guessed | enriched | imported | manual
  emailStatus   String?   // verified | catch_all | unverified | invalid
  emailVerifiedAt DateTime?
  enrichmentTriedAt DateTime? // last paid enrichment (Hunter) attempt — skip on re-run to avoid re-billing
  hasContactForm Boolean?  // contact form detected on their website
  facebookUrl   String?   // Facebook page found during scraping
  description   String?
  category      String?   // website_proposal | crm
  address       String?
  phone         String?
  rating        Float?
  mapsUrl       String?
  placeId       String?
  latitude      Float?    // from Places location field (or backfill-geo script)
  longitude     Float?
  score         Int       @default(0)
  state          String    @default("discovered")
  lastTouchedAt  DateTime?
  messages       Message[]
  jobs           Job[]
  calendarEvents CalendarEvent[]
  campaign      Campaign  @relation(fields: [campaignId], references: [id])
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  @@unique([campaignId, placeId])
  @@index([orgId])
}

// Geocoding cache for the coverage map: each area/city string is geocoded via
// Places exactly once ever. Not org-scoped — a place name's coordinates are
// not tenant data.
model GeoCache {
  id        String   @id @default(cuid())
  query     String   @unique
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
}

model Message {
  id             String   @id @default(cuid())
  leadId         String
  direction      String   // outbound | inbound | system
  subject        String?
  body           String   // canonical plain text: thread previews, AI follow-up context, search
  bodyHtml       String?  // rich-text rendering (replies/follow-ups); null for plain/AI-generated
  resendId       String?  // Resend email ID for webhook correlation
  deliveryStatus String?  // sent | delivered | opened | bounced | complained
  sentAt         DateTime @default(now())
  lead           Lead     @relation(fields: [leadId], references: [id])
}

model Job {
  id           String   @id @default(cuid())
  leadId       String
  type         String   // followup_2 | followup_3 | followup_4
  scheduledAt  DateTime
  status       String   @default("pending") // pending | done | cancelled | failed
  overrideBody String? // user-edited body; when set, cron sends this instead of AI-drafting
  bullmqId     String? // reserved for future BullMQ integration
  lead         Lead     @relation(fields: [leadId], references: [id])
}

model ActivityEvent {
  id         String   @id @default(cuid())
  orgId      String
  type       String   // scouted | opener_sent | followup_sent | followup_queued | reply_hot | reply_warm | reply_cold | bounced | suppressed | meeting_booked
  summary    String   // human-readable one-liner shown in the feed
  leadId     String?
  campaignId String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([orgId, createdAt(sort: Desc)])
}

model Settings {
  id                   String   @id @default(cuid())
  orgId                String   @unique // per-org settings
  userId               String   @unique // legacy token.sub provenance; superseded by orgId
  offerText            String?
  fromEmail            String?
  fromName             String?
  signatureHtml        String?  // reusable email signature (rich text); appended at send-time
  signatureText        String?  // plain-text fallback for the text/* part + WhatsApp
  resendApiKey         String?
  firecrawlApiKey      String?
  anthropicApiKey      String?
  emailVerifierApiKey  String?
  enrichmentProvider   String?  @default("hunter") // hunter | anymailfinder | apify
  enrichmentApiKey     String?
  apifyApiKey          String?  // Apify token — fallback email finder when Hunter quota is spent
  googleMapsApiKey     String?
  telegramChatId       String?
  telegramConnectCode  String?  @unique // short-lived code binding /start <code> to this org
  googleClientId       String?
  googleClientSecret   String?
  googleRefreshToken   String?
  calendarId           String?  @default("primary")
  dailySendLimit          Int     @default(100)
  perCampaignDailyLimit   Int     @default(50)
  sendThrottleSeconds     Int     @default(30)
  autoSendReplies         Boolean @default(false)
  notifyHotOnly           Boolean @default(false)
  notifyEmailDigest       Boolean @default(false)
  ghlApiKey               String?
  ghlLocationId           String?
  ghlPipelineId           String?
}

model CalendarEvent {
  id          String   @id @default(cuid())
  leadId      String
  googleEventId String?
  meetLink    String?
  startTime   DateTime
  endTime     DateTime
  title       String
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id])
}

model Suppression {
  id        String   @id @default(cuid())
  orgId     String
  email     String
  reason    String   // bounced | unsubscribed | manual | complained
  createdAt DateTime @default(now())

  @@unique([orgId, email])
  @@index([orgId])
}

model PendingConfirmation {
  id          String   @id @default(cuid())
  leadId      String
  type        String   // "booking" | "reply"
  context     String   // JSON: { slots, slotIndex, inboundBody, companyName, ... }
  status      String   @default("pending") // pending | confirmed | skipped
  createdAt   DateTime @default(now())
}
